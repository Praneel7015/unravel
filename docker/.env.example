# Unravel Sovereign Self-Host Configuration (`.env`)
# Generate a bcrypt password hash with:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-strong-passphrase'

UNRAVEL_VAULT_DOMAIN=vault.example.com
WEBDAV_BIND_ADDRESS=127.0.0.1
WEBDAV_PORT=8443
WEBDAV_USERNAME=unravel_sovereign
WEBDAV_PASSWORD_BCRYPT=$2a$14$REPLACE_WITH_YOUR_BCRYPT_HASH
